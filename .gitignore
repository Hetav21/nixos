# Log files
*.log

# Backup and editor swap files
*.bak*
*.backup
*.swp

# Patch files
patch

# Security: Prevent accidental secret commits (keys, certs, env files)
*.asc
*.pem
*.key
.env*

# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history
